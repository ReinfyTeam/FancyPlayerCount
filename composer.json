{
    "name": "reinfyteam/fancy-player-count",
    "description": "PocketMine-MP plugin that displays an adjusted player count in server queries.",
    "type": "project",
    "license": "LGPL-2.1-only",
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "pocketmine/pocketmine-mp": "^5.44.3"
    },
    "autoload": {
        "psr-4": {
            "ReinfyTeam\\FancyPlayerCount\\": "src/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse -c phpstan.neon.dist"
    }
}
